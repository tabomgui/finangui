APP_NAME=finangui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=http://localhost:5174

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=finangui
DB_USERNAME=finangui
DB_PASSWORD=finangui

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_SAME_SITE must stay "lax": "strict" breaks the Google OAuth callback (state lost).
SESSION_DOMAIN=localhost
# Dev runs over plain HTTP (http://localhost:8001); a secure cookie would never
# be sent back by the browser. Production must set this to true (see
# .env.production.example) since it runs behind a TLS-terminating proxy.
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Acima do --timeout do worker (ver docker-compose.prod.yml): sem isso, um job
# que ainda está rodando passa de "em execução" para "disponível de novo" e um
# segundo worker o pega em paralelo.
DB_QUEUE_RETRY_AFTER=660
CACHE_STORE=database

MAIL_MAILER=log

REGISTRATION_ENABLED=false
PRIMARY_CURRENCY=BRL

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/api/auth/google/callback
